# ==========================================================================
# .gitignore del ecosistema Java/JVM: Java, Kotlin, Groovy, Scala, Maven,
# Gradle, Ant, IDEs (IntelliJ, Eclipse, NetBeans, VS Code) y artefactos de
# diagnóstico de la JVM.
# ==========================================================================

# --- Sistema operativo ---
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.nfs*

# --- Java: compilados y empaquetados ---
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.jmod
*.ctxt
.mtj.tmp/
# Los wrappers sí se versionan
!**/gradle/wrapper/gradle-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar

# --- JVM: diagnósticos, dumps y logs ---
hs_err_pid*
replay_pid*
*.hprof
*.hprof.gz
*.jfr
*.phd
*.trc
javacore.*.txt
# Core dumps (archivos); los directorios llamados core sí se versionan
core
core.[0-9]*
!core/
*.log
*.log.[0-9]*
gc*.log*
*.exec
*.ec
jcstress-results-*.bin.gz

# --- Maven ---
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.flattened-pom.xml
.mvn/timing.properties
.mvn/.develocity/
.mvn/.gradle-enterprise/

# --- Gradle ---
.gradle/
build/
!**/src/**/build/
.gradletasknamecache
gradle-app.setting
.kotlin/
local.properties

# --- Ant / Ivy ---
dist/
ivy-cache/
.ant-targets-build.xml

# --- Kotlin / Groovy / Scala ---
*.kotlin_module
.bsp/
.bloop/
.metals/
metals.sbt
project/target/
project/project/

# --- IntelliJ IDEA ---
# .idea/ completo: se regenera al importar el build de Gradle y lleva nombres de JDK locales
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/
atlassian-ide-plugin.xml
cmake-build-*/

# --- Eclipse ---
.classpath
.project
.settings/
.factorypath
.apt_generated/
.apt_generated_tests/
.metadata/
bin/
tmp/
*.tmp
*.bak
*.swp
.loadpath
.recommenders/
.externalToolBuilders/
*.launch

# --- NetBeans ---
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# --- VS Code ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.history/
**/*.code-workspace

# --- Datos locales de los labs ---
*.db
*.sqlite
*.mv.db
*.trace.db

# --- Secretos ---
.env
.env.*
*.pem
*.p12
*.jks
*.keystore
!**/src/test/resources/**/*.p12
!**/src/test/resources/**/*.jks
